# test_* build artifacts (binaries placed in BUILDDIR=. by default).
# Negate tests/*.c so test SOURCES are tracked -- without this the pattern
# also hides tests/test_consensus.c, tests/test_serialize.c, etc.
/test_*
asan_test_*
tsan_test_*
cov_test_*
!tests/test_*.c
*.o
coverage_report/
obj_cov/
dudect_crypto
.audit-snapshot
audit/
fuzz/afl_out/
config.mk
nodes.conf

# Never commit private keys or key directories
*.key
**/keys/
*_sk
hs_keys/
*.pem
*.p12
site/
fuzz/*
!fuzz/fuzz_*.c
!fuzz/fuzz_stubs.h
deploy.sh
deploy-debug.sh
fuzzer.sh
BUG_AUDIT.md
BUILD_ID
promo/
.claude/

